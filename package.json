{
  "name": "@map-colonies/3d-shared",
  "version": "1.0.0",
  "description": "Shared types, schemas, and constants for MapColonies 3D services",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "jest",
    "clean": "rimraf dist",
    "prepack": "npm run build",
    "release": "standard-version"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@map-colonies/types": "^1.4.0",
    "geojson": "^0.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.14",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MapColonies/3d-shared.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
